@using BookList.Models
@using BookList.ViewModel

@model BookViewModel

@if (Model?.Errors?.Length > 0)
{
    <div class="text-danger">
        @Html.Raw(Model.Errors)
    </div>
}

<form method="post">
    <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" class="form-control" placeholder="Enter title" value="@Model?.Title">
    </div>
    <div class="form-group">
        <label>Author</label>
        <input type="text" name="author" class="form-control" placeholder="Enter author" value="@Model?.Author">
    </div>
    <div class="form-group">
        <label>Genre</label>
        <input type="text" name="genre" class="form-control" placeholder="Enter genre" value="@Model?.Genre">
    </div>
    <div class="form-group">
        <label>Year</label>
        <input type="number" name="year" class="form-control" placeholder="Enter year" value="@Model?.Year">
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>